{
  "manifest_version": 3,
  "name": "SORT - Session Observer Recorder Tracker",
  "version": "2.29.6",
  "description": "Records support sessions with screen video and browser activity timelines for troubleshooting and ticket follow-up.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "desktopCapture",
    "alarms",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ws-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "build-info.js",
        "diagnostics-core.js",
        "diagnostics.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SORT",
    "default_icon": {
      "16": "icons/idle16.png",
      "32": "icons/idle32.png",
      "48": "icons/idle48.png",
      "128": "icons/idle128.png"
    }
  },
  "icons": {
    "16": "icons/idle16.png",
    "32": "icons/idle32.png",
    "48": "icons/idle48.png",
    "128": "icons/idle128.png"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Start or stop a SORT recording",
      "global": true
    }
  },
  "minimum_chrome_version": "116"
}
